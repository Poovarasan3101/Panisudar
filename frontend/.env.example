# Backend API Base URL
# In local development: leave empty or use /api to utilize the Vite proxy (http://localhost:8000)
# In production (e.g. Vercel): set to your deployed backend URL (e.g. https://panisudar-backend.onrender.com/api)
VITE_API_URL=/api

# Optional: External AI Chatbot endpoint
# VITE_AI_CHAT_API_URL=https://api.openai.com/v1/chat/completions
# VITE_AI_CHAT_API_KEY=
